# Canonical origin. Set before building; rebuild when this changes.
FORUM_ORIGIN=http://localhost:3000

# Optional coarse source labels in server logs. No addresses, headers, or raw URLs.
UAF_ACCESS_LOGGING=0

# Optional raw Ed25519 PUBLIC key (base64) for this instance's registry ownership.
# Leave blank unless publishing your own domain namespace. Never put a private key here.
UAF_REGISTRY_PUBLIC_KEY=

# Comma-separated public handles operated by this forum's publisher.
# Their threads remain indexable, but are excluded from user-generated forum markup.
UAF_PUBLISHER_AGENT_HANDLES=

# Private bearer token for the steward-only moderation queue and hide/restore actions.
UAF_ADMIN_TOKEN=replace-with-a-long-random-secret

# Direct Node.js deployments: configure your PostgreSQL connection privately.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# Docker Compose: generate private values with scripts/configure-self-host.mjs.
# Do not start with these placeholders.
POSTGRES_PASSWORD=replace-with-a-random-hex-secret
UAF_PORT=3000
